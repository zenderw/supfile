# === PostgreSQL (REQUIRED) ===
POSTGRES_USER=supfile
POSTGRES_PASSWORD=changeme
POSTGRES_DB=supfile

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SCHEMA=public

DATABASE_URL=postgresql://supfile:changeme@localhost:5432/supfile?schema=public

# === Docker (optionnel — defaults dans le compose) ===
POSTGRES_IMAGE=postgres:16-alpine
ADMINER_IMAGE=adminer:4-standalone

POSTGRES_CONTAINER_NAME=supfile-postgres
POSTGRES_DEV_CONTAINER_NAME=supfile-postgres-dev
ADMINER_CONTAINER_NAME=supfile-adminer-dev
API_CONTAINER_NAME=supfile-api
WEB_CONTAINER_NAME=supfile-web

API_DOCKERFILE=apps/api/Dockerfile
WEB_DOCKERFILE=apps/web/Dockerfile

POSTGRES_VOLUME_NAME=supfile_pg_data
STORAGE_VOLUME_NAME=supfile_storage
POSTGRES_DATA_DIR=/var/lib/postgresql/data

POSTGRES_HOST_PORT=5432
POSTGRES_CONTAINER_PORT=5432
ADMINER_HOST_PORT=8080
ADMINER_CONTAINER_PORT=8080
API_HOST_PORT=3000
WEB_HOST_PORT=80
WEB_CONTAINER_PORT=80

RESTART_POLICY=unless-stopped

HEALTHCHECK_INTERVAL=5s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=10

# === API (REQUIRED) ===
API_PORT=3000
API_STORAGE_PATH=/data
JWT_SECRET=remplace-par-une-chaine-aleatoire-de-64-caracteres-minimum
JWT_REFRESH_SECRET=autre-chaine-aleatoire-distincte-du-secret-access

JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

STORAGE_PATH=./storage

PORT=3000

# === OAuth Google ===
GOOGLE_CLIENT_ID=dev-placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dev-placeholder-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
WEB_OAUTH_REDIRECT_URL=http://localhost:5173/auth/oauth-callback

# === Frontend Vite (build-time) ===
VITE_API_URL=http://localhost:3000/api/v1

# === Mobile Expo (REMPLACER 192.168.X.X par ton IP LAN, ipconfig sous Windows) ===
EXPO_PUBLIC_API_URL=http://192.168.1.118:3000/api/v1
EXPO_PUBLIC_WEB_URL=http://192.168.1.118
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
