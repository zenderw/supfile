graph LR
    Utilisateur((Utilisateur))

    subgraph Recherche
        UC_Search[Rechercher fichiers/dossiers]
        UC_FilterType[Filtrer par catégorie MIME]
        UC_FilterDate[Filtrer par période]
    end

    subgraph Dashboard
        UC_Dashboard[Consulter le dashboard]
        UC_ViewQuota[Voir l'espace utilisé/disponible]
        UC_ViewRepartition[Voir la répartition par catégorie]
        UC_ViewRecent[Accéder aux fichiers récents]
        UC_ClickCategory[Cliquer sur une catégorie]
    end

    Utilisateur --> UC_Search
    UC_Search -.extend.-> UC_FilterType
    UC_Search -.extend.-> UC_FilterDate

    Utilisateur --> UC_Dashboard
    UC_Dashboard -.include.-> UC_ViewQuota
    UC_Dashboard -.include.-> UC_ViewRepartition
    UC_Dashboard -.include.-> UC_ViewRecent
    UC_ViewRepartition -.extend.-> UC_ClickCategory
    UC_ClickCategory --> UC_Search
